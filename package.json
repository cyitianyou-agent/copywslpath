{
  "name": "copy-wsl-path",
  "displayName": "Copy WSL Path",
  "description": "Copy Explorer file/folder path as WSL path",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:copyWslPath.copyFromExplorer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copyWslPath.copyFromExplorer",
        "title": "Copy WSL Path"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "copyWslPath.copyFromExplorer",
          "group": "navigation@50",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "copyWslPath.copyFromExplorer",
          "group": "navigation@50",
          "when": "!explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "Copy WSL Path",
      "properties": {
        "copyWslPath.showNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show notification with full copied WSL path after success."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/*.test.js",
    "prepackage": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.2"
  }
}
