{
  "name": "copy-wsl-path",
  "displayName": "Copy WSL Path",
  "description": "Copy Explorer file/folder path as WSL path",
  "version": "0.0.3",
  "publisher": "cyitianyou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyitianyou-agent/copywslpath.git"
  },
  "bugs": {
    "url": "https://github.com/cyitianyou-agent/copywslpath/issues"
  },
  "homepage": "https://github.com/cyitianyou-agent/copywslpath#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:copyWslPath.copyRawFromExplorer",
    "onCommand:copyWslPath.copyRealRawFromExplorer",
    "onCommand:copyWslPath.copyFromExplorer",
    "onCommand:copyWslPath.copyRealFromExplorer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copyWslPath.copyRawFromExplorer",
        "title": "Copy Path"
      },
      {
        "command": "copyWslPath.copyRealRawFromExplorer",
        "title": "Copy Real Path"
      },
      {
        "command": "copyWslPath.copyFromExplorer",
        "title": "Copy WSL Path"
      },
      {
        "command": "copyWslPath.copyRealFromExplorer",
        "title": "Copy Real WSL Path"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "copyWslPath.copyRawFromExplorer",
          "group": "navigation@48",
          "when": "explorerResourceIsFolder && config.copyWslPath.showCopyPathMenu"
        },
        {
          "command": "copyWslPath.copyRawFromExplorer",
          "group": "navigation@48",
          "when": "!explorerResourceIsFolder && config.copyWslPath.showCopyPathMenu"
        },
        {
          "command": "copyWslPath.copyRealRawFromExplorer",
          "group": "navigation@49",
          "when": "explorerResourceIsFolder && config.copyWslPath.showCopyRealPathMenu"
        },
        {
          "command": "copyWslPath.copyRealRawFromExplorer",
          "group": "navigation@49",
          "when": "!explorerResourceIsFolder && config.copyWslPath.showCopyRealPathMenu"
        },
        {
          "command": "copyWslPath.copyFromExplorer",
          "group": "navigation@50",
          "when": "explorerResourceIsFolder && config.copyWslPath.showCopyWslPathMenu"
        },
        {
          "command": "copyWslPath.copyFromExplorer",
          "group": "navigation@50",
          "when": "!explorerResourceIsFolder && config.copyWslPath.showCopyWslPathMenu"
        },
        {
          "command": "copyWslPath.copyRealFromExplorer",
          "group": "navigation@51",
          "when": "explorerResourceIsFolder && config.copyWslPath.showCopyRealWslPathMenu"
        },
        {
          "command": "copyWslPath.copyRealFromExplorer",
          "group": "navigation@51",
          "when": "!explorerResourceIsFolder && config.copyWslPath.showCopyRealWslPathMenu"
        }
      ]
    },
    "configuration": {
      "title": "Copy WSL Path",
      "properties": {
        "copyWslPath.showNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show notification with full copied WSL path after success."
        },
        "copyWslPath.showCopyPathMenu": {
          "type": "boolean",
          "default": true,
          "description": "Show the Copy Path menu item in Explorer context menu."
        },
        "copyWslPath.showCopyRealPathMenu": {
          "type": "boolean",
          "default": true,
          "description": "Show the Copy Real Path menu item in Explorer context menu."
        },
        "copyWslPath.showCopyWslPathMenu": {
          "type": "boolean",
          "default": true,
          "description": "Show the Copy WSL Path menu item in Explorer context menu."
        },
        "copyWslPath.showCopyRealWslPathMenu": {
          "type": "boolean",
          "default": true,
          "description": "Show the Copy Real WSL Path menu item in Explorer context menu."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/*.test.js",
    "prepackage": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.2"
  }
}
